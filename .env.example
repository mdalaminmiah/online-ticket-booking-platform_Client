# Vite only exposes variables prefixed with VITE_ to the browser.
# A different prefix is silently ignored at build time.

# Base URL of the API server.
VITE_API_URL=http://localhost:5000

# BetterAuth is served by the same server.
VITE_BETTER_AUTH_URL=http://localhost:5000

# Stripe test publishable key from https://dashboard.stripe.com/test/apikeys
# (starts pk_test_). Must belong to the SAME Stripe account as the server's
# STRIPE_SECRET_KEY, or payment confirmation fails.
VITE_STRIPE_PUBLISHABLE_KEY=

# imgbb API key, used for ticket image upload in the vendor Add/Update form.
# https://api.imgbb.com/
VITE_IMGBB_API_KEY=
